# Explicit qmldir for components/progress/
# Lists every QML type defined in this folder so Qt 6.5+ does not
# rely on implicit-module resolution (which is fragile when the
# parent folder has both .qml files and sub-directories).

LoadingOverlay 1.0 LoadingOverlay.qml
ProgressBar 1.0 ProgressBar.qml
SkeletonLoader 1.0 SkeletonLoader.qml
Spinner 1.0 Spinner.qml
